/*
 * T113Claw Build-time Secrets
 *
 * Copy this file to t113claw_secrets.h and fill in your values.
 *   cp t113claw_secrets.h.example t113claw_secrets.h
 *
 * This file is gitignored. Rebuild after any change.
 */

#pragma once

/* WiFi (for boards with WiFi, auto-connect on boot) */
#define T113CLAW_SECRET_WIFI_SSID         ""
#define T113CLAW_SECRET_WIFI_PASS         ""

/* LLM Provider: "openai" or "claude" */
#define T113CLAW_SECRET_MODEL_PROVIDER    "openai"

/* LLM API Key */
#define T113CLAW_SECRET_API_KEY           ""

/* LLM Model name (e.g., "gpt-4o", "claude-opus-4-5", "deepseek-chat") */
#define T113CLAW_SECRET_MODEL             ""

/* Custom API URL (for OpenAI-compatible providers like DeepSeek, Qwen, etc.) */
/* Leave empty to use default OpenAI/Claude endpoints */
#define T113CLAW_SECRET_API_URL           ""

/* Feishu Bot credentials */
#define T113CLAW_SECRET_FEISHU_APP_ID     ""
#define T113CLAW_SECRET_FEISHU_APP_SECRET ""

/* iFlytek (讯飞) credentials */
#define T113CLAW_SECRET_XFYUN_APPID       ""
#define T113CLAW_SECRET_XFYUN_APIKEY      ""
#define T113CLAW_SECRET_XFYUN_APISECRET   ""

/* HTTP Proxy (optional) */
#define T113CLAW_SECRET_PROXY_HOST        ""
#define T113CLAW_SECRET_PROXY_PORT        ""

/* Web search */
/* provider: auto / sogou / tavily */
#define T113CLAW_SECRET_SEARCH_PROVIDER   ""
/* Set to "1" on boards that can only access domestic sites */
#define T113CLAW_SECRET_SEARCH_DOMESTIC_ONLY ""
/* Optional Tavily key for host-side or unrestricted network environments */
#define T113CLAW_SECRET_TAVILY_API_KEY    ""

/* LAN remote control (optional) */
/* Host can be plain IP/hostname or a full base URL such as http://192.168.1.10:8765 */
#define T113CLAW_SECRET_REMOTE_HOST       ""
/* Leave empty to use the default port 8765 */
#define T113CLAW_SECRET_REMOTE_PORT       ""
#define T113CLAW_SECRET_REMOTE_USERNAME   ""
#define T113CLAW_SECRET_REMOTE_PASSWORD   ""
